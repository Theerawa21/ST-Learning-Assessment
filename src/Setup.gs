function setupSystem(){
 var expected=text_(props_().getProperty('SETUP_OWNER_EMAIL'),254).toLowerCase(),email=text_(Session.getActiveUser().getEmail(),254).toLowerCase();
 if(!expected||!email||email!==expected)fail_('ACCESS','ตั้งค่า SETUP_OWNER_EMAIL ให้ตรงบัญชีผู้ดูแล และรันจาก Apps Script editor');
 var lock=LockService.getScriptLock();lock.waitLock(30000);
 try{
  if(!props_().getProperty('DATABASE_ID'))props_().setProperty('DATABASE_ID',SpreadsheetApp.create('ST-Learning Assessment — Database').getId());
  ['REPORT_FOLDER_ID','BACKUP_FOLDER_ID'].forEach(function(k){if(!props_().getProperty(k))props_().setProperty(k,DriveApp.createFolder(k==='REPORT_FOLDER_ID'?'ST-Learning Reports':'ST-Learning Backups').getId());});
  var ss=book_();Object.keys(SCHEMA_).forEach(function(n){var s=ss.getSheetByName(n);if(!s){s=ss.insertSheet(n);s.getRange(1,1,1,SCHEMA_[n].length).setValues([SCHEMA_[n]]);s.setFrozenRows(1);}});
  var users=readRecords_('Users');if(!users.length)append_('Users',{id:uid_(),email:email,name:email.split('@')[0],roles:['ADMIN'],departmentIds:[],active:true,createdAt:now_(),updatedAt:now_()});
  else if(!users.some(function(u){return u.email===email&&u.active===true&&hasRole_(u,'ADMIN');}))fail_('ACCESS','ผู้รันไม่ใช่ผู้ดูแลที่ใช้งานอยู่');
  if(!props_().getProperty('AUTH_MODE'))props_().setProperty('AUTH_MODE','WORKSPACE');if(!props_().getProperty('EMAIL_ENABLED'))props_().setProperty('EMAIL_ENABLED','false');
  return {ready:true,checks:checkReadiness_()};
 }finally{lock.releaseLock();}
}
function checkReadiness_(){var checks=[];['DATABASE_ID','REPORT_FOLDER_ID','BACKUP_FOLDER_ID'].forEach(function(k){try{var id=props_().getProperty(k);if(!id)throw Error('missing');if(k==='DATABASE_ID')SpreadsheetApp.openById(id);else DriveApp.getFolderById(id);checks.push({name:k,ok:true});}catch(e){checks.push({name:k,ok:false,message:'ยังไม่ได้ตั้งค่าหรือไม่มีสิทธิ์เข้าถึง'});}});checks.push({name:'ตัวชี้วัดที่นำเข้าแล้ว',ok:readRecords_('Indicators').length>0});return checks;}
function backupDatabase_(){var lock=LockService.getScriptLock();lock.waitLock(30000);try{var data={schemaVersion:1,createdAt:now_(),tables:{}};Object.keys(SCHEMA_).forEach(function(t){data.tables[t]=rawRead_(t);});var folder=DriveApp.getFolderById(props_().getProperty('BACKUP_FOLDER_ID')),file=folder.createFile('backup-'+data.createdAt.replace(/[:.]/g,'-')+'.json',JSON.stringify(data),'application/json');var retention=Number(props_().getProperty('BACKUP_RETENTION_DAYS'))||30,cutoff=Date.now()-Math.max(1,retention)*86400000,files=folder.getFiles();while(files.hasNext()){var f=files.next();if(f.getName().indexOf('backup-')===0&&f.getDateCreated().getTime()<cutoff)f.setTrashed(true);}return {fileId:file.getId(),createdAt:data.createdAt};}finally{lock.releaseLock();}}
function listBackups_(actor){authorize_(actor,'ADMIN');var iter=DriveApp.getFolderById(props_().getProperty('BACKUP_FOLDER_ID')).getFiles(),rows=[];while(iter.hasNext()){var f=iter.next();if(f.getName().indexOf('backup-')===0)rows.push({id:f.getId(),name:f.getName(),createdAt:f.getDateCreated().toISOString()});}return rows.sort(function(a,b){return b.createdAt.localeCompare(a.createdAt);});}
function restoreToCopy_(actor,backupId){authorize_(actor,'ADMIN');var allowed=listBackups_(actor).some(function(b){return b.id===backupId;});if(!allowed)fail_('ACCESS','ไม่พบไฟล์ในโฟลเดอร์สำรองของระบบ');var data=JSON.parse(DriveApp.getFileById(backupId).getBlob().getDataAsString());if(data.schemaVersion!==1||!data.tables)fail_('BACKUP','รูปแบบสำรองไม่ถูกต้อง');var ss=SpreadsheetApp.create('ST-Learning Restored Copy '+now_());Object.keys(SCHEMA_).forEach(function(t){if(!Array.isArray(data.tables[t]))fail_('BACKUP','ขาดตาราง '+t);var s=ss.insertSheet(t),keys=SCHEMA_[t];ensureRows_(s,data.tables[t].length+1);s.getRange(1,1,1,keys.length).setValues([keys]);if(data.tables[t].length)s.getRange(2,1,data.tables[t].length,keys.length).setNumberFormat('@').setValues(data.tables[t].map(function(r){return keys.map(function(k){return 'j:'+JSON.stringify(r[k]===undefined?null:r[k]);});}));s.setFrozenRows(1);});return {spreadsheetId:ss.getId(),url:ss.getUrl(),message:'สร้างสำเนาแล้ว ยังไม่ได้เปลี่ยนฐานข้อมูลใช้งานจริง'};}
function installTriggers_(actor){authorize_(actor,'ADMIN');var existing=ScriptApp.getProjectTriggers().map(function(t){return t.getHandlerFunction();});if(existing.indexOf('backupDatabase_')<0)ScriptApp.newTrigger('backupDatabase_').timeBased().everyDays(1).atHour(2).create();if(props_().getProperty('EMAIL_ENABLED')==='true'&&existing.indexOf('sendPendingEmails_')<0)ScriptApp.newTrigger('sendPendingEmails_').timeBased().everyMinutes(10).create();return {installed:true,emailEnabled:props_().getProperty('EMAIL_ENABLED')==='true'};}
function recoverOperation_(actor,id){authorize_(actor,'ADMIN');var lock=LockService.getScriptLock();lock.waitLock(30000);try{var op=findRecord_('OperationRequests',id);if(!op||['STARTED','RECOVERY_REQUIRED'].indexOf(op.status)<0)fail_('RECOVERY','รายการนี้ไม่ใช่คำสั่งค้าง');if(op.snapshotFileId){var data=JSON.parse(DriveApp.getFileById(op.snapshotFileId).getBlob().getDataAsString());Object.keys(data).forEach(function(t){if(!SCHEMA_[t])fail_('RECOVERY','snapshot ไม่ถูกต้อง');rawWrite_(t,data[t]);});SpreadsheetApp.flush();}op.status='FAILED';op.error='ผู้ดูแลกู้คืน snapshot ก่อนทำรายการแล้ว';op.updatedAt=now_();upsert_('OperationRequests',op);return {recovered:true};}finally{lock.releaseLock();}}
