var CHECKLIST_=['ตัวชี้วัด/ผลการเรียนรู้ครบถ้วน','รหัสและข้อความถูกต้องตามหลักสูตร','การจัดกลุ่มตัวชี้วัดเหมาะสม','สิ่งที่ประเมินสอดคล้องกับตัวชี้วัด','เครื่องมือประเมินเหมาะสม','ช่วงการประเมินเหมาะสม','เกณฑ์การประเมินชัดเจน','การประเมินครอบคลุมผลลัพธ์ที่ต้องการ','ข้อมูลเป็นไปตามแนวทางของโรงเรียน'];
function stageActorAllowed_(actor,document){var s=findRecord_('Subjects',document.subjectId);if(document.status==='PENDING_HEAD')return headOf_(actor,s);if(document.status==='PENDING_ASSESSMENT')return hasRole_(actor,'ASSESSMENT');if(document.status==='PENDING_ACADEMIC')return hasRole_(actor,'ACADEMIC');return false;}
function assertReviewerAvailable_(document){var subject=findRecord_('Subjects',document.subjectId),users=readRecords_('Users');if(!users.some(function(u){return u.active&&u.id!==document.authorId&&headOf_(u,subject);}))fail_('REVIEWER','ยังไม่มีหัวหน้ากลุ่มสาระหรือผู้ตรวจแทนที่ตรวจงานนี้ได้ กรุณาติดต่อผู้ดูแล');}
function submitAnalysis_(actor,documentId,expectedRevision,requestId){return mutate_(actor,requestId,'submitAnalysis',hash_([documentId,expectedRevision]),function(){var d=findRecord_('AnalysisDocuments',documentId);if(!d)fail_('NOT_FOUND','ไม่พบเอกสาร');authorize_(actor,'SUBJECT_EDIT',findRecord_('Subjects',d.subjectId));if(d.authorId!==actor.id)fail_('ACCESS','ส่งตรวจได้เฉพาะงานของตนเอง');expectRevision_(d,expectedRevision);if(EDITABLE_.indexOf(d.status)<0)fail_('LOCKED','เอกสารนี้ส่งตรวจแล้วหรืออนุมัติแล้ว');var validation=validateAnalysis_(d,groupsFor_(d.id),requiredIndicators_(d.subjectId));if(!validation.canSubmit)fail_('INCOMPLETE',validation.errors.map(function(e){return e.message;}).join('; '));assertReviewerAvailable_(d);d.status='PENDING_HEAD';d.updatedAt=now_();upsert_('AnalysisDocuments',d);if(typeof notifyTransition_==='function')notifyTransition_({document:d,actor:actor,message:'มีเอกสารส่งตรวจ: '+findRecord_('Subjects',d.subjectId).name});return d;});}
function reviewAnalysis_(actor,input,requestId){var before=findRecord_('AnalysisDocuments',input.documentId);if(before&&before.authorId===actor.id)fail_('SELF','ผู้จัดทำไม่สามารถตรวจรับรองงานของตนเองได้');return mutate_(actor,requestId,'reviewAnalysis',hash_(input),function(){
 var d=findRecord_('AnalysisDocuments',input.documentId);if(!d)fail_('NOT_FOUND','ไม่พบเอกสาร');if(actor.id===d.authorId)fail_('SELF','ผู้จัดทำไม่สามารถตรวจรับรองงานของตนเองได้');expectRevision_(d,input.expectedRevision);if(input.expectedStatus!==d.status)fail_('CONFLICT','ขั้นตอนเอกสารเปลี่ยนไปแล้ว กรุณาเปิดเอกสารล่าสุดก่อนตรวจ');if(!stageActorAllowed_(actor,d))fail_('ACCESS','ไม่มีสิทธิ์ตรวจในขั้นตอนนี้');if(['APPROVE','RETURN'].indexOf(input.decision)<0)fail_('INPUT','การตัดสินไม่ถูกต้อง');
 var list=input.checklist;if(!Array.isArray(list)||list.length!==9||new Set(list.map(function(c){return c.number;})).size!==9)fail_('CHECKLIST','ตอบแบบตรวจสอบให้ครบ 9 ข้อ');
 list=list.map(function(c){if(!Number.isInteger(c.number)||c.number<1||c.number>9||['PASS','FIX','NA'].indexOf(c.value)<0||c.value==='NA'&&!text_(c.reason,1000))fail_('CHECKLIST','ผลตรวจหรือเหตุผลไม่ครบถ้วน');return {number:c.number,value:c.value,reason:text_(c.reason,1000),comment:text_(c.comment,1500)};});
 if(input.decision==='APPROVE'&&list.some(function(c){return c.value==='FIX';}))fail_('CHECKLIST','มีรายการที่ต้องแก้ไข ไม่สามารถรับรองได้');var comment=text_(input.comment,4000);if(input.decision==='RETURN'&&!comment)fail_('INPUT','กรุณาระบุข้อเสนอแนะก่อนส่งกลับ');
 var rowComments=Array.isArray(input.rowComments)?input.rowComments.map(function(c){if(!groupsFor_(d.id).some(function(g){return g.id===c.rowId;}))fail_('INPUT','ไม่พบแถวที่แสดงความคิดเห็น');return {rowId:c.rowId,rowNumber:groupsFor_(d.id).findIndex(function(g){return g.id===c.rowId;})+1,comment:required_(c.comment,'ความเห็นรายแถว',1500)};}):[];
 var stage=d.status.replace('PENDING_',''),r=append_('ReviewRecords',{documentId:d.id,revision:d.revision,reviewerId:actor.id,reviewerName:actor.name,stage:stage,result:input.decision,comment:comment,rowComments:rowComments,createdAt:now_()});list.forEach(function(c){c.reviewId=r.id;append_('ReviewChecklist',c);});
 var next={PENDING_HEAD:'PENDING_ASSESSMENT',PENDING_ASSESSMENT:'PENDING_ACADEMIC',PENDING_ACADEMIC:'APPROVED'};d.status=input.decision==='RETURN'?'RETURNED_'+stage:next[d.status];d.updatedAt=now_();upsert_('AnalysisDocuments',d);if(typeof notifyTransition_==='function')notifyTransition_({document:d,actor:actor,message:input.decision==='RETURN'?'เอกสารถูกส่งกลับแก้ไข: '+comment:'เอกสารผ่านการตรวจระดับ '+stage});return d;
 });}
function listReviewQueue_(actor,filters){var rows=readRecords_('AnalysisDocuments').filter(function(d){return d.authorId!==actor.id&&stageActorAllowed_(actor,d);}).map(function(d){d.subject=findRecord_('Subjects',d.subjectId);var u=findRecord_('Users',d.authorId);d.authorName=u?u.name:'';return d;});return page_(rows,filters);}
