function page_(items,filters){filters=filters||{};var page=Math.max(1,Number(filters.page)||1),size=Math.min(100,Math.max(1,Number(filters.pageSize)||20));return {items:items.slice((page-1)*size,page*size),total:items.length,page:page,pageSize:size};}
function listSubjects_(actor,filters){filters=filters||{};var q=text_(filters.query,200).toLowerCase();var rows=readRecords_('Subjects').filter(function(s){return canReadSubject_(actor,s)&&(!q||(s.code+' '+s.name).toLowerCase().indexOf(q)>=0)&&(!filters.departmentId||s.departmentId===filters.departmentId)&&(!filters.grade||s.grade===filters.grade)&&(!filters.year||String(s.year)===String(filters.year))&&(!filters.term||String(s.term)===String(filters.term));});var docs=readRecords_('AnalysisDocuments'),assign=readRecords_('TeachingAssignments'),users=readRecords_('Users'),maps=readRecords_('SubjectIndicators');rows.forEach(function(s){s.teacherIds=assign.filter(function(a){return a.subjectId===s.id;}).map(function(a){return a.teacherId;});s.teacherNames=assign.filter(function(a){return a.subjectId===s.id;}).map(function(a){var u=users.find(function(x){return x.id===a.teacherId;});return u?u.name:'';});var d=docs.filter(function(d){if(d.subjectId!==s.id)return false;if(hasRole_(actor,'TEACHER')&&isTeacherOf_(actor,s)&&!hasRole_(actor,'ADMIN'))return d.authorId===actor.id;try{authorize_(actor,'DOCUMENT_READ',d);return true;}catch(e){return false;}}).sort(function(a,b){return String(b.updatedAt).localeCompare(String(a.updatedAt));})[0];s.documentId=d&&d.id||'';s.status=d&&d.status||'NOT_STARTED';s.indicatorCount=maps.filter(function(m){return m.subjectId===s.id;}).length;});if(filters.status)rows=rows.filter(function(s){return s.status===filters.status;});return page_(rows,filters);}
function saveSubject_(actor,input,requestId){authorize_(actor,'ADMIN');return mutate_(actor,requestId,'saveSubject',hash_(input),function(){
 var old=input.id?findRecord_('Subjects',input.id):null,r={id:old?old.id:uid_(),code:required_(input.code,'รหัสวิชา',50),name:required_(input.name,'ชื่อวิชา',250),type:required_(input.type,'ประเภทวิชา',30),grade:required_(input.grade,'ระดับชั้น',30),departmentId:required_(input.departmentId,'กลุ่มสาระ',100),curriculumId:required_(input.curriculumId,'หลักสูตร',100),term:required_(input.term,'ภาคเรียน',2),year:required_(input.year,'ปีการศึกษา',4),active:input.active!==false,updatedAt:now_()};
 if(['พื้นฐาน','เพิ่มเติม'].indexOf(r.type)<0||['1','2','3'].indexOf(r.term)<0||!/^\d{4}$/.test(r.year))fail_('INPUT','ประเภทวิชา ภาคเรียน หรือปีการศึกษาไม่ถูกต้อง');
 if(!findRecord_('Departments',r.departmentId)||!findRecord_('Curricula',r.curriculumId))fail_('INPUT','ไม่พบกลุ่มสาระหรือหลักสูตร');
 if(readRecords_('Subjects').some(function(s){return s.id!==r.id&&s.code===r.code&&s.grade===r.grade&&s.term===r.term&&s.year===r.year;}))fail_('DUPLICATE','รายวิชานี้มีในปีและภาคเรียนดังกล่าวแล้ว');
 if(old&&(old.curriculumId!==r.curriculumId||old.grade!==r.grade||old.departmentId!==r.departmentId)&&readRecords_('AnalysisDocuments').some(function(d){return d.subjectId===r.id;}))fail_('LOCKED','รายวิชามีเอกสารแล้ว กรุณาสร้างรายวิชาใหม่หากเปลี่ยนหลักสูตรหรือระดับชั้น');
 var teacherIds=Array.isArray(input.teacherIds)?Array.from(new Set(input.teacherIds)):[];teacherIds.forEach(function(id){var u=findRecord_('Users',id);if(!u||!u.active||!hasRole_(u,'TEACHER'))fail_('INPUT','ผู้สอนต้องมีบทบาทครูและใช้งานอยู่');});
 if(old&&readRecords_('AnalysisDocuments').some(function(d){return d.subjectId===r.id&&teacherIds.indexOf(d.authorId)<0;}))fail_('LOCKED','ไม่สามารถนำผู้จัดทำเอกสารเดิมออกจากรายวิชาได้ ให้ปิดรายวิชาแทน');
 if(old&&(old.curriculumId!==r.curriculumId||old.grade!==r.grade||old.departmentId!==r.departmentId))removeWhere_('SubjectIndicators',function(m){return m.subjectId===r.id;});upsert_('Subjects',r);removeWhere_('TeachingAssignments',function(a){return a.subjectId===r.id;});teacherIds.forEach(function(t){append_('TeachingAssignments',{subjectId:r.id,teacherId:t});});return r;
 });}
