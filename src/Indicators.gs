function normalizeIndicator_(row){var r={id:row.id||uid_(),curriculumId:required_(row.curriculumId,'หลักสูตร',100),departmentId:required_(row.departmentId,'กลุ่มสาระ',100),standard:text_(row.standard,200),code:required_(row.code,'รหัสตัวชี้วัด',100),fullText:required_(row.fullText,'ข้อความตัวชี้วัด',6000),grade:required_(row.grade,'ระดับชั้น',30),kind:text_(row.kind,50),reference:required_(row.reference,'แหล่งอ้างอิงที่ตรวจสอบแล้ว',1000),active:row.active!==false};if(!findRecord_('Curricula',r.curriculumId)||!findRecord_('Departments',r.departmentId))fail_('CURRICULUM','ไม่พบหลักสูตรหรือกลุ่มสาระ');return r;}
function indicatorKey_(r){return [r.curriculumId,r.departmentId,r.grade,r.code].join('|');}
function previewIndicatorImport_(actor,input){authorize_(actor,'ADMIN');var rows=input.rows;
 if(input.csv!==undefined){var csv=required_(input.csv,'ข้อมูล CSV',80000).replace(/^\uFEFF/,'');var values=Utilities.parseCsv(csv),keys=values.shift().map(function(k){return k.trim();});rows=values.filter(function(r){return r.some(function(c){return String(c).trim();});}).map(function(row){var r={};keys.forEach(function(k,i){r[k]=row[i]||'';});return r;});}
 if(input.spreadsheetId){var sheet=SpreadsheetApp.openById(required_(input.spreadsheetId,'Spreadsheet ID',150)).getSheetByName(required_(input.sheetName,'ชื่อชีต',100));if(!sheet)fail_('INPUT','ไม่พบชีตนำเข้า');var values2=sheet.getDataRange().getValues(),keys2=values2.shift().map(String);rows=values2.map(function(row){var r={};keys2.forEach(function(k,i){r[k]=row[i];});return r;});}
 if(!Array.isArray(rows)||rows.length>500)fail_('LIMIT','นำเข้าได้ไม่เกิน 500 แถวต่อครั้ง');var seen={};readRecords_('Indicators').forEach(function(r){seen[indicatorKey_(r)]=true;});var result={validRows:[],errors:[],duplicates:[]};rows.forEach(function(row,i){try{var r=normalizeIndicator_(row),key=indicatorKey_(r);if(seen[key])result.duplicates.push({row:i+2,code:r.code});else {seen[key]=true;result.validRows.push(r);}}catch(e){result.errors.push({row:i+2,message:e.message});}});return result;
}
function commitIndicatorImport_(actor,rows,requestId){authorize_(actor,'ADMIN');return mutate_(actor,requestId,'importIndicators',hash_(rows),function(){if(!Array.isArray(rows)||!rows.length)fail_('INPUT','ไม่มีข้อมูลสำหรับนำเข้า');var result=previewIndicatorImport_(actor,{rows:rows});if(result.errors.length)fail_('INPUT',result.errors[0].message);result.validRows.forEach(function(r){r.id=uid_();append_('Indicators',r);});return {inserted:result.validRows.length,skipped:result.duplicates.length};});}
function saveIndicator_(actor,input,requestId){authorize_(actor,'ADMIN');return mutate_(actor,requestId,'saveIndicator',hash_(input),function(){var r=normalizeIndicator_(input);if(input.id&&readRecords_('GroupIndicators').some(function(m){return m.indicatorId===input.id;})||input.id&&readRecords_('SubjectIndicators').some(function(m){return m.indicatorId===input.id;}))fail_('LOCKED','ตัวชี้วัดถูกใช้งานแล้ว ให้เพิ่มข้อมูลในหลักสูตรรุ่นใหม่แทนการแก้ต้นฉบับ');if(readRecords_('Indicators').some(function(x){return x.id!==r.id&&indicatorKey_(x)===indicatorKey_(r);}))fail_('DUPLICATE','รหัสตัวชี้วัดซ้ำ');return upsert_('Indicators',r);});}
function setSubjectIndicators_(actor,subjectId,indicatorIds,requestId){authorize_(actor,'ADMIN');return mutate_(actor,requestId,'mapIndicators',hash_([subjectId,indicatorIds]),function(){var s=findRecord_('Subjects',subjectId);if(!s)fail_('INPUT','ไม่พบรายวิชา');if(readRecords_('AnalysisDocuments').some(function(d){return d.subjectId===s.id;}))fail_('LOCKED','มีเอกสารแล้ว ไม่สามารถเปลี่ยนชุดตัวชี้วัดอ้างอิงของรายวิชานี้ได้');if(!Array.isArray(indicatorIds))fail_('INPUT','ตัวชี้วัดไม่ถูกต้อง');var ids=Array.from(new Set(indicatorIds));ids.forEach(function(id){var i=findRecord_('Indicators',id);if(!i||i.active===false||i.curriculumId!==s.curriculumId||i.departmentId!==s.departmentId||i.grade!==s.grade)fail_('CURRICULUM','ตัวชี้วัดไม่ตรงหลักสูตร กลุ่มสาระ หรือระดับชั้น');});removeWhere_('SubjectIndicators',function(m){return m.subjectId===subjectId;});ids.forEach(function(id){append_('SubjectIndicators',{subjectId:subjectId,indicatorId:id});});return {count:ids.length};});}
function listIndicators_(actor,filters){filters=filters||{};var q=text_(filters.query,200).toLowerCase();var allowed=hasRole_(actor,'ADMIN')||hasRole_(actor,'ASSESSMENT')||hasRole_(actor,'ACADEMIC');var subjects=readRecords_('Subjects').filter(function(s){return canReadSubject_(actor,s);});return page_(readRecords_('Indicators').filter(function(i){return (allowed||subjects.some(function(s){return s.curriculumId===i.curriculumId&&s.departmentId===i.departmentId&&s.grade===i.grade;}))&&(!filters.curriculumId||i.curriculumId===filters.curriculumId)&&(!filters.departmentId||i.departmentId===filters.departmentId)&&(!filters.grade||i.grade===filters.grade)&&(!q||(i.code+' '+i.fullText).toLowerCase().indexOf(q)>=0);}),filters);}
