var PERIODS_=['BEFORE_MIDTERM','MIDTERM','AFTER_MIDTERM','FINAL'];
var EDITABLE_=['DRAFT','REVISION_DRAFT','RETURNED_HEAD','RETURNED_ASSESSMENT','RETURNED_ACADEMIC'];
function requiredIndicators_(subjectId){var ids=readRecords_('SubjectIndicators').filter(function(m){return m.subjectId===subjectId;}).map(function(m){return m.indicatorId;});var subject=findRecord_('Subjects',subjectId),indicators=readRecords_('Indicators').filter(function(i){return ids.indexOf(i.id)>=0;});if(!subject||indicators.length!==ids.length||indicators.some(function(i){return i.curriculumId!==subject.curriculumId||i.departmentId!==subject.departmentId||i.grade!==subject.grade||i.active===false;}))fail_('CURRICULUM','ชุดตัวชี้วัดอ้างอิงไม่ตรงรายวิชา กรุณาให้ผู้ดูแลตรวจสอบ');return indicators;}
function groupsFor_(documentId){var gi=readRecords_('GroupIndicators'),items=readRecords_('AssessmentItems'),periods=readRecords_('AssessmentPeriods');return readRecords_('AssessmentGroups').filter(function(g){return g.documentId===documentId;}).sort(function(a,b){return a.order-b.order;}).map(function(g){var item=items.find(function(i){return i.groupId===g.id;})||{};return {id:g.id,indicatorIds:gi.filter(function(m){return m.groupId===g.id;}).map(function(m){return m.indicatorId;}),assessment:item.assessment||'',tools:item.tools||[],criteria:item.criteria||'',periods:periods.filter(function(p){return p.itemId===item.id;}).map(function(p){return p.periodCode;})};});}
function validateAnalysis_(document,groups,requiredIndicators){
 var errors=[],warnings=[],used={},counts={};PERIODS_.forEach(function(p){counts[p]=0;});
 if(!requiredIndicators.length)errors.push({message:'รายวิชายังไม่ได้กำหนดตัวชี้วัดอ้างอิง กรุณาให้ผู้ดูแลตั้งค่า'});
 if(!groups.length)errors.push({message:'ยังไม่มีรายการประเมิน'});
 groups.forEach(function(g,index){var row=index+1;if(!g.indicatorIds.length)errors.push({row:row,message:'ยังไม่ได้เลือกตัวชี้วัด'});g.indicatorIds.forEach(function(id){if(used[id])warnings.push({row:row,message:'ตัวชี้วัดถูกใช้ในหลายรายการ โปรดตรวจความซ้ำซ้อน'});used[id]=true;});[['assessment','สิ่งที่ประเมิน'],['criteria','เกณฑ์การประเมิน']].forEach(function(x){if(!text_(g[x[0]],6000))errors.push({row:row,message:'ยังไม่ระบุ'+x[1]});});if(!g.tools.length)errors.push({row:row,message:'ยังไม่ได้ระบุเครื่องมือประเมิน'});if(!g.periods.length)errors.push({row:row,message:'เลือกช่วงการประเมินอย่างน้อยหนึ่งช่วง'});g.periods.forEach(function(p){if(PERIODS_.indexOf(p)<0)errors.push({row:row,message:'ช่วงการประเมินไม่ถูกต้อง'});else counts[p]++;});});
 var missing=requiredIndicators.filter(function(i){return !used[i.id];}).map(function(i){return i.id;});if(missing.length)errors.push({message:'ยังขาดตัวชี้วัด '+missing.length+' ข้อ'});
 PERIODS_.forEach(function(p){if(!counts[p])warnings.push({message:'ยังไม่มีแผนในช่วง '+(PERIOD_LABELS_[p]||p)});});
 return {canSubmit:errors.length===0,coveragePercent:requiredIndicators.length?Math.round((requiredIndicators.length-missing.length)*100/requiredIndicators.length):0,missingIndicatorIds:missing,errors:errors,warnings:warnings,periodCounts:counts};
}
function getAnalysis_(actor,documentId){var d=findRecord_('AnalysisDocuments',documentId);authorize_(actor,'DOCUMENT_READ',d);var groups=groupsFor_(d.id),required=requiredIndicators_(d.subjectId);var reviews=readRecords_('ReviewRecords').filter(function(r){return r.documentId===d.id;});reviews.forEach(function(r){r.checklist=readRecords_('ReviewChecklist').filter(function(c){return c.reviewId===r.id;});});var author=findRecord_('Users',d.authorId);return {document:d,authorName:author?author.name:'',subject:findRecord_('Subjects',d.subjectId),groups:groups,requiredIndicators:required,reviews:reviews,validation:validateAnalysis_(d,groups,required)};}
function normalizeGroups_(groups,required){if(!Array.isArray(groups)||groups.length>150)fail_('INPUT','จำนวนรายการประเมินต้องไม่เกิน 150 รายการ');var allowed=required.map(function(i){return i.id;});return groups.map(function(g){var ids=Array.isArray(g.indicatorIds)?Array.from(new Set(g.indicatorIds)):[];if(ids.some(function(id){return allowed.indexOf(id)<0;}))fail_('CURRICULUM','ตัวชี้วัดไม่อยู่ในชุดที่รายวิชาต้องประเมิน');var periods=Array.isArray(g.periods)?Array.from(new Set(g.periods)):[];if(periods.some(function(p){return PERIODS_.indexOf(p)<0;}))fail_('INPUT','ช่วงการประเมินไม่ถูกต้อง');var tools=Array.isArray(g.tools)?Array.from(new Set(g.tools.map(function(t){return text_(t,500);}).filter(Boolean))):[];return {id:uid_(),indicatorIds:ids,assessment:text_(g.assessment,6000),tools:tools,periods:periods,criteria:text_(g.criteria,6000)};});}
function persistGroups_(documentId,groups){var oldGroups=readRecords_('AssessmentGroups').filter(function(g){return g.documentId===documentId;}).map(function(g){return g.id;}),oldItems=readRecords_('AssessmentItems').filter(function(i){return oldGroups.indexOf(i.groupId)>=0;}).map(function(i){return i.id;});removeWhere_('AssessmentPeriods',function(p){return oldItems.indexOf(p.itemId)>=0;});removeWhere_('AssessmentItems',function(i){return oldGroups.indexOf(i.groupId)>=0;});removeWhere_('GroupIndicators',function(i){return oldGroups.indexOf(i.groupId)>=0;});removeWhere_('AssessmentGroups',function(g){return g.documentId===documentId;});groups.forEach(function(g,n){append_('AssessmentGroups',{id:g.id,documentId:documentId,order:n});g.indicatorIds.forEach(function(id){append_('GroupIndicators',{groupId:g.id,indicatorId:id});});var item=append_('AssessmentItems',{groupId:g.id,assessment:g.assessment,tools:g.tools,criteria:g.criteria});g.periods.forEach(function(p){append_('AssessmentPeriods',{itemId:item.id,periodCode:p});});});}
function snapshotDocument_(actor,d,groups){var snapshot={document:d,subject:findRecord_('Subjects',d.subjectId),authorName:actor.name,groups:groups,indicators:requiredIndicators_(d.subjectId)};var encoded=JSON.stringify(snapshot);if(encoded.length>40000)fail_('LIMIT','เอกสารยาวเกินขนาดรุ่นที่จัดเก็บได้ กรุณาลดข้อความหรือแบ่งรายการรายวิชา');append_('DocumentVersions',{documentId:d.id,revision:d.revision,snapshot:snapshot,actorId:actor.id,createdAt:now_()});}
function saveAnalysis_(actor,input,requestId){return mutate_(actor,requestId,'saveAnalysis',hash_(input),function(){
 var d=input.documentId?findRecord_('AnalysisDocuments',input.documentId):null;if(input.documentId&&!d)fail_('NOT_FOUND','ไม่พบเอกสาร');var subject=findRecord_('Subjects',d?d.subjectId:input.subjectId);authorize_(actor,'SUBJECT_EDIT',subject);if(subject.active===false)fail_('LOCKED','รายวิชาถูกปิดใช้งาน');
 if(d){if(d.authorId!==actor.id)fail_('ACCESS','แก้ไขได้เฉพาะเอกสารที่ตนจัดทำ');if(EDITABLE_.indexOf(d.status)<0)fail_('LOCKED','เอกสารอยู่ระหว่างตรวจหรืออนุมัติแล้ว');expectRevision_(d,input.expectedRevision);d.revision++;}
 else {if(readRecords_('AnalysisDocuments').some(function(x){return x.subjectId===subject.id&&x.authorId===actor.id;}))fail_('DUPLICATE','มีเอกสารของรายวิชานี้แล้ว กรุณาเปิดเอกสารเดิม');d={id:uid_(),subjectId:subject.id,authorId:actor.id,status:'DRAFT',revision:1,createdAt:now_()};}
 var required=requiredIndicators_(subject.id),groups=normalizeGroups_(input.groups||[],required);d.updatedAt=now_();upsert_('AnalysisDocuments',d);persistGroups_(d.id,groups);snapshotDocument_(actor,d,groups);return {document:d,validation:validateAnalysis_(d,groups,required)};
 });}
function createRevision_(actor,documentId,requestId){return mutate_(actor,requestId,'createRevision',hash_(documentId),function(){var old=findRecord_('AnalysisDocuments',documentId);authorize_(actor,'DOCUMENT_READ',old);authorize_(actor,'SUBJECT_EDIT',findRecord_('Subjects',old.subjectId));if(old.authorId!==actor.id||old.status!=='APPROVED')fail_('LOCKED','สร้างฉบับปรับปรุงได้เฉพาะเอกสารอนุมัติที่ตนจัดทำ');if(readRecords_('AnalysisDocuments').some(function(d){return d.parentDocumentId===old.id;}))fail_('DUPLICATE','ฉบับนี้มีเอกสารปรับปรุงแล้ว กรุณาเปิดฉบับปรับปรุงเดิม');var d={id:uid_(),subjectId:old.subjectId,authorId:actor.id,status:'REVISION_DRAFT',revision:1,parentDocumentId:old.id,createdAt:now_(),updatedAt:now_()},groups=normalizeGroups_(groupsFor_(old.id),requiredIndicators_(old.subjectId));upsert_('AnalysisDocuments',d);persistGroups_(d.id,groups);snapshotDocument_(actor,d,groups);return d;});}
