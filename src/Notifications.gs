function notifyTransition_(event){var d=event.document,users=readRecords_('Users'),ids=[d.authorId];users.forEach(function(u){if(u.active&&u.id!==d.authorId&&stageActorAllowed_(u,d))ids.push(u.id);});Array.from(new Set(ids)).filter(function(id){return id!==event.actor.id;}).forEach(function(id){append_('Notifications',{recipientId:id,documentId:d.id,message:text_(event.message,2000),readAt:null,emailStatus:props_().getProperty('EMAIL_ENABLED')==='true'?'PENDING':'DISABLED',createdAt:now_()});});return {inApp:true,emailStatus:'QUEUED_IF_ENABLED'};}
function listNotifications_(actor){return readRecords_('Notifications').filter(function(n){return n.recipientId===actor.id;}).sort(function(a,b){return b.createdAt.localeCompare(a.createdAt);}).slice(0,100);}
function markNotificationRead_(actor,id){var n=findRecord_('Notifications',id);if(!n||n.recipientId!==actor.id)fail_('ACCESS','ไม่มีสิทธิ์อ่านแจ้งเตือนนี้');n.readAt=now_();return upsert_('Notifications',n);}
function sendPendingEmails_(){
 if(props_().getProperty('EMAIL_ENABLED')!=='true')return {status:'DISABLED'};
 var lock=LockService.getScriptLock();lock.waitLock(30000);try{var rows=rawRead_('Notifications'),users=rawRead_('Users'),sent=0;rows.filter(function(n){return n.emailStatus==='PENDING';}).slice(0,20).forEach(function(n){var u=users.find(function(u){return u.id===n.recipientId&&u.active;});if(!u){n.emailStatus='SKIPPED';return;}if(MailApp.getRemainingDailyQuota()<1)return;n.emailStatus='SENDING';rawWrite_('Notifications',rows);SpreadsheetApp.flush();try{MailApp.sendEmail({to:u.email,subject:'ST-Learning Assessment: แจ้งสถานะเอกสาร',body:n.message+'\nกรุณาเข้าสู่ระบบของโรงเรียนเพื่อตรวจรายละเอียด'});n.emailStatus='SENT';sent++;}catch(e){n.emailStatus='FAILED';}});rawWrite_('Notifications',rows);return {status:'PROCESSED',sent:sent};}finally{lock.releaseLock();}
}
